@model IEnumerable<ModulosComerciales.Models.Producto>

@{
    ViewData["Title"] = "Gestión de productos";
}

<h1>Gestión de productos</h1>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

<p>
    <a asp-action="Crear" class="btn btn-primary">
        Registrar producto
    </a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Precio</th>
            <th>Marca</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var producto in Model)
        {
            <tr>
                <td>@producto.Nombre</td>
                <td>@producto.Descripcion</td>
                <td>@producto.Precio.ToString("C0", new System.Globalization.CultureInfo("es-CO"))</td>
                <td>@producto.Marca.Nombre</td>
                <td>
                    <a asp-action="Editar"
                       asp-route-id="@producto.ProductoId"
                       class="btn btn-warning btn-sm">
                        Editar
                    </a>

                    <a asp-action="Eliminar"
                       asp-route-id="@producto.ProductoId"
                       class="btn btn-danger btn-sm">
                        Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
