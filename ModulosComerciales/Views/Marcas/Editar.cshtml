@model ModulosComerciales.Models.Marca

@{
    ViewData["Title"] = "Editar marca";
}

<h1>Editar marca</h1>

<form asp-action="Editar" asp-route-id="@Model.MarcaId" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="MarcaId" />

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Nombre" class="form-label">Nombre de la marca</label>
        <input asp-for="Nombre" class="form-control" required />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Descripcion" class="form-label">Descripción</label>
        <textarea asp-for="Descripcion"
                  class="form-control"
                  rows="3"
                  required></textarea>
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>

    @if (ViewBag.EsAdministrador == true)
    {
        <div class="mb-3">
            <label asp-for="UsuarioId" class="form-label">
                Estudiante vendedor
            </label>

            <select asp-for="UsuarioId"
                    class="form-select"
                    asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(
                                        ViewBag.Usuarios, "UsuarioId", "Nombre"))"
                    required>
                <option value="">Seleccione un estudiante</option>
            </select>

            <span asp-validation-for="UsuarioId" class="text-danger"></span>
        </div>
    }

    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
